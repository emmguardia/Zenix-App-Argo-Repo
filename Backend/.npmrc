# Défense supply-chain : refuse tout paquet publié il y a moins de 24h.
# Si une version compromise est publiée sur npm, la communauté a typiquement
# le temps de la détecter et de la retirer avant qu'elle ne soit installée ici.
# Valeur en minutes (1440 = 24h). Requiert pnpm >= 10.
minimum-release-age=1440

# Empêche pnpm d'exécuter les scripts post-install des dépendances sans
# approbation explicite (postinstall = vecteur classique de compromission
# supply-chain). Les paquets approuvés vont dans pnpm.onlyBuiltDependencies
# de package.json.
#
# Ce dépôt tournait auparavant sous `npm ci`, qui exécute TOUS les scripts
# d'installation sans distinction — sur le service qui détient en runtime la
# clé secrète Stripe, les identifiants R2, le mot de passe de la base et le
# SESSION_SECRET.
ignore-scripts=true

# Force l'engine déclarée dans package.json au lieu de simplement avertir.
engine-strict=true

# Évite les sorties interactives et le bruit en CI.
fund=false
audit=false
update-notifier=false
